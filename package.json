{
  "name": "clinicbook-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "dev:webpack": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run typecheck && npm run lint && npm run test:coverage",
    "test:concurrency": "tsx scripts/test-concurrency.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit": "npm audit --audit-level=high",
    "test:postgres": "tsx tests/postgres/verify.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "globals": "16.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
