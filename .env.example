# Running preview uses only synthetic data in SQLite. Do NOT store patient data.
CLINICBOOK_MODE=demo
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Future deployment adapters. These do NOT switch the full app repository to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local PostgreSQL test harness (dedicated disposable database ONLY).
TEST_DATABASE_URL=postgresql://clinicbook_test:local-test-only@127.0.0.1:5432/clinicbook_verify
