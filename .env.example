# =============================================================================
# ClinicBook Environment Configuration (.env.example)
# =============================================================================

# [MANDATORY] Application operational mode:
# - 'production' (DEFAULT / REQUIRED for production deployments) — forces PostgreSQL + Supabase with RLS/RPCs.
# - 'demo' — enables local SQLite demo mode (`data/clinicbook.sqlite`) for local preview and testing.
# Production runtime requires an explicit production mode; demo is forbidden there.
CLINICBOOK_MODE=production

COOKIE_SECURE=true
NEXT_PUBLIC_APP_URL=https://clinicbook.local

# CSP is enforced automatically in production. Leave explicit enforcement off for local development.
CSP_ENFORCE=false
# Set true only for a temporary staging reporting rollout, not a live deployment.
CSP_REPORT_ONLY=false

# ─── Supabase PostgreSQL & Auth (Required in production) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Strictly reserved for internal admin/cron jobs (e.g. appointment expiration).
# ⚠ NEVER use this key in client-facing requests or clinical EMR routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test-only escape hatch for isolated auth doubles without inviteUserByEmail.
# It is ignored in production; real deployments must deliver a password-setup invitation.
ALLOW_TEAM_PASSWORD_FALLBACK=false

# ─── Shared Rate Limiting (Mandatory in production) ───
# HTTP write endpoints return 503 when these are missing or Redis is unreachable.
# Use the Upstash REST credentials, never a public client token.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token
# At least 32 random characters. HMACs identifiers before they reach Redis.
RATE_LIMIT_KEY_SECRET=

# Trusted ingress topology. Leave unset on Vercel; the platform overwrites
# x-vercel-forwarded-for. For a self-hosted proxy, set the exact hop count and
# make the origin unreachable except through that proxy.
TRUSTED_PROXY_HOPS=0

# Local PostgreSQL test harness (disposable database for integration/RLS verification)
TEST_DATABASE_URL=postgresql://clinicbook_test:local-test-only@127.0.0.1:5432/clinicbook_verify

# ─── Clinical AI Gateway (Multi-Provider: Groq / Gemini / OpenRouter / OpenAI) ───
# Recommended free/fast Arabic providers (set ANY ONE in .env.local — never commit real keys here):
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Legacy / Custom Responses API Gateway (Optional fallback)
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-5.6-sol

# ─── Scheduled Retention Cron (/api/cron/retention) ───
# Mandatory in production; endpoint fails closed (500) if unset under NODE_ENV=production.
CRON_SECRET=

# ─── Demo Configuration (Used ONLY when CLINICBOOK_MODE=demo) ───
# DEMO_PASSWORD=demo1234
