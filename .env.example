# Running preview uses only synthetic data in SQLite. Do NOT store patient data.
# Keep CLINICBOOK_MODE=demo until the full data layer migration to Supabase is complete.
# Setting it to "production" prematurely will cause empty interfaces / query errors.
CLINICBOOK_MODE=demo
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase Auth ───
# When both URL and ANON_KEY are set, Supabase Auth handles sign-up/sign-in.
# When empty, the app falls back to SQLite demo authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NOT required for authentication.
# Reserved for future admin operations (data migration, webhooks).
# ⚠ Never expose this key in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Local PostgreSQL test harness (dedicated disposable database ONLY).
TEST_DATABASE_URL=postgresql://clinicbook_test:local-test-only@127.0.0.1:5432/clinicbook_verify
